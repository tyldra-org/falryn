# Dependencies and package-manager state
node_modules/
.bun/

# Build, test, and generated output
/dist/
/build/
/out/
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
/blob-report/
*.lcov
*.tsbuildinfo
# `bun build --compile` writes an intermediate beside its output and renames it
# on success. An interrupted build leaves a ~60 MB file named for a content
# hash: disposable, unreproducible, and one `git add -A` away from being
# committed.
*.bun-build

# Caches and temporary work
/.cache/
/.tmp/
/tmp/
/temp/
*.tmp
*.temp
*.swp
*.swo
*~

# Logs and process state
*.log
logs/
*.pid
*.pid.lock

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example
.envrc
!.envrc.example

# Editors and IDEs
.idea/
.fleet/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Operating-system metadata
.DS_Store
._*
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Local-only product and engineering documentation. Move only verified,
# shipped behavior into docs/ before committing it.
/docs/internal/
