{
  "name": "falryn",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A local terminal coding agent built with Bun and TypeScript.",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": "1.4.1"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "quality": "biome check . --error-on-warnings",
    "quality:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify:repository": "bun run tools/quality/repository-integrity.ts",
    "audit:issues": "bun run tools/governance/issue-readiness-cli.ts",
    "audit:roadmap": "bun run tools/governance/roadmap-governance-cli.ts",
    "generate:model-catalogs": "bun run tools/catalogs/model-catalogs.ts",
    "check:model-catalogs": "bun run tools/catalogs/model-catalogs.ts --check",
    "check:static": "bun run --parallel quality typecheck verify:repository check:model-catalogs",
    "test": "bun run tools/quality/test-shards.ts",
    "test:compiled": "bun test src/main.compiled.test.ts src/tui/runtime/shell.compiled.test.ts",
    "test:changed": "bun run tools/quality/test-shards.ts --changed=main --only-failures && bun run test:whole-tree",
    "test:whole-tree": "bun test ./src/*.test.ts --path-ignore-patterns='**/*.compiled.test.ts' --only-failures",
    "test:watch": "bun test --hot --only-failures",
    "test:timings": "bun run tools/quality/test-timings.ts",
    "test:platform-baseline": "bun test tools/benchmarks/benchmark-regression.test.ts src/cli-boundaries.test.ts src/sqlite-boundaries.test.ts src/source-path-fixtures.test.ts src/main.test.ts src/cli/version.test.ts src/data/lifecycle/roots.test.ts src/integrations/process/host-process-identity.test.ts src/integrations/process/host-process-capture-ownership.test.ts",
    "measure": "FALRYN_MEASURE=1 bun test src/data/measurement.test.ts",
    "benchmark:compare": "bun run tools/benchmarks/benchmark-regression.ts",
    "benchmark:hush-coverage": "bun run tools/benchmarks/hush-command-coverage.ts",
    "benchmark:hush-ls": "bun run tools/benchmarks/hush-ls-scorecard.ts",
    "benchmark:hush-tree": "bun run tools/benchmarks/hush-tree-scorecard.ts",
    "benchmark:hush-projections": "bun run tools/benchmarks/hush-projection-scorecard.ts",
    "benchmark:loom": "bun run tools/benchmarks/loom-scorecard.ts",
    "benchmark:brief": "bun run tools/benchmarks/brief-scorecard.ts",
    "benchmark:compression": "bun run tools/benchmarks/compression-scorecard.ts",
    "build": "bun build src/main.ts --compile --splitting --outfile dist/falryn",
    "build:macos-arm64": "bun build src/main.ts --compile --splitting --target=bun-darwin-arm64 --outfile dist/falryn",
    "build:windows-x64": "bun build src/main.ts --compile --splitting --target=bun-windows-x64 --outfile dist/falryn",
    "smoke:linux-x64": "FALRYN_COMPILED_SMOKE_TARGET=linux-x64 bun test src/main.compiled.test.ts",
    "smoke:macos-arm64": "FALRYN_COMPILED_SMOKE_TARGET=darwin-arm64 bun test src/main.compiled.test.ts src/tui/runtime/shell.compiled.test.ts",
    "smoke:windows-x64": "FALRYN_COMPILED_SMOKE_TARGET=win32-x64 bun test src/main.compiled.test.ts",
    "check": "bun run check:static && bun run test:changed",
    "check:full": "bun run check:static && bun run test",
    "ci": "bun run check:static && bun audit && bun run test && bun run build && bun run test:compiled",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-reconciler": "0.33.0",
    "@types/semver": "7.8.0",
    "@types/yargs": "17.0.35",
    "@xterm/headless": "6.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@google/genai": "2.24.0",
    "@modelcontextprotocol/client": "2.1.0",
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/react": "0.5.12",
    "jsonc-parser": "3.3.1",
    "openai": "7.23.0",
    "react": "19.3.0",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "yargs": "18.2.0",
    "zod": "4.6.5"
  }
}
