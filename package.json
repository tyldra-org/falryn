{
  "name": "falryn",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A local terminal coding agent built with Bun and TypeScript.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "quality": "biome check . --error-on-warnings",
    "quality:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify:repository": "bun run tools/repository-integrity.ts",
    "generate:model-catalogs": "bun run tools/model-catalogs.ts",
    "check:model-catalogs": "bun run tools/model-catalogs.ts --check",
    "check:static": "bun run --parallel quality typecheck verify:repository check:model-catalogs",
    "check:fast": "bun run check:static && bun run test:parallel",
    "check:changed": "bun run check:static && bun run test:changed",
    "test": "bun test",
    "test:parallel": "bun test --parallel=4 --path-ignore-patterns=src/cli/process-boundary.test.ts --only-failures && bun test src/cli/process-boundary.test.ts --only-failures",
    "test:changed": "bun test --changed=main --only-failures",
    "test:watch": "bun test --hot --only-failures",
    "test:platform-baseline": "bun test tools/benchmark-regression.test.ts src/cli-boundaries.test.ts src/sqlite-boundaries.test.ts src/source-path-fixtures.test.ts src/main.test.ts src/cli/version.test.ts src/data/roots.test.ts",
    "measure": "FALRYN_MEASURE=1 bun test src/data/measurement.test.ts",
    "benchmark:compare": "bun run tools/benchmark-regression.ts",
    "benchmark:hush-coverage": "bun run tools/hush-command-coverage.ts",
    "benchmark:hush-ls": "bun run tools/hush-ls-scorecard.ts",
    "benchmark:hush-tree": "bun run tools/hush-tree-scorecard.ts",
    "benchmark:hush-projections": "bun run tools/hush-projection-scorecard.ts",
    "benchmark:loom": "bun run tools/loom-scorecard.ts",
    "benchmark:brief": "bun run tools/brief-scorecard.ts",
    "benchmark:compression": "bun run tools/compression-scorecard.ts",
    "build": "bun build src/main.ts --compile --outfile dist/falryn",
    "build:macos-arm64": "bun build src/main.ts --compile --target=bun-darwin-arm64 --outfile dist/falryn",
    "build:windows-x64": "bun build src/main.ts --compile --target=bun-windows-x64 --outfile dist/falryn",
    "smoke:macos-arm64": "FALRYN_COMPILED_SMOKE_TARGET=darwin-arm64 bun test src/main.compiled.test.ts src/tui/shell.compiled.test.ts",
    "smoke:windows-x64": "FALRYN_COMPILED_SMOKE_TARGET=win32-x64 bun test src/main.compiled.test.ts",
    "check": "bun run check:static && bun run test",
    "ci": "bun run check:static && bun run build && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-reconciler": "0.33.0",
    "@types/yargs": "17.0.35",
    "@xterm/headless": "6.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@google/genai": "2.19.0",
    "@opentui/core": "0.5.9",
    "@opentui/keymap": "0.5.9",
    "@opentui/react": "0.5.9",
    "jsonc-parser": "3.3.1",
    "openai": "7.8.0",
    "react": "19.2.8",
    "yargs": "18.1.0",
    "zod": "4.5.1"
  }
}
